# Copy to .env.local for local development, or add these as environment
# variables in your host (AWS Amplify: App settings → Environment variables).
# Both are read at BUILD time, so redeploy after changing them.

# Your live domain, without a trailing slash. Used for SEO, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Where "Book a Demo" requests go. Leave empty to hide the email from the site;
# the form will then tell visitors booking is being set up.
NEXT_PUBLIC_CONTACT_EMAIL=
